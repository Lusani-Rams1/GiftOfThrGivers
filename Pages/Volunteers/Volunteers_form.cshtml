@page
@model Gift_of_the_Givers_Relief_App.Pages.Volonteers.Volonteers_formModel
@{
	ViewData["Title"] = "Volunteer page";
}

<div class="form-wrapper">
    <form method="post" class="form">
        <label>Full Name*</label>
        <input type="text" name="FullName" required />
        <br />
        <label>Email*</label>
        <input type="email" name="Email" required />
        <br />
        <label>Phone Number*</label>
        <input type="tel" name="PhoneNumber" required />
        <br />
        <label>City/Area*</label>
        <input type="text" name="Location" required />
        <br />
        <label>Which cause do you want to help with?*</label>
        <select name="DisasterId" required>
            <option value="">General Volunteering</option>
            <option value="1">KwaZulu-Natal Floods</option>
            <option value="2">Western Cape Wildfires</option>
            <option value="3">Eastern Cape Drought</option>
        </select>
        <br />
        <label>Availability*</label>
        <select name="Availability" required>
            <option value="Weekdays">Weekdays</option>
            <option value="Weekends">Weekends</option>
            <option value="Both">Both</option>
            <option value="Flexible">Flexible</option>
        </select>
        <br />
        <label>Skills/Experience (optional)</label>
        <textarea name="Skills" maxlength="500" placeholder="e.g. first aid, driving, logistics, translation"></textarea>
        <br />
        <label>
            <input type="checkbox" name="HasOwnTransport" /> I have my own transport
        </label>
        <br />
        <label>Message (optional)</label>
        <textarea name="Message" maxlength="500"></textarea>
        <br />
        <button type="submit">Sign Up to Volunteer</button>
    </form>
</div>