<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <!--add logo-->
        <a asp-page="/Index" class="brand">
            <span class="brand-name">Gift of the Givers</span>
        </a>
        <!-- Disasters/Volunteer/Donate/Login, these links i'll link them after making the pages but for now the nav isn't working -->
        <nav class="main-nav">
            <a asp-page="/Index">Home</a>
            <a asp-page="/Disasters/Details">Disasters</a>
            <a asp-page="/Volunteers/Volunteers_form">Volunteer</a>
            <a asp-page="/Donators/Donators_form" class="btn-donate-nav">Donate</a>
            <a asp-page="/Account/Login" class="btn-login">Login</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        &copy; @DateTime.Now.Year Gift of the Givers Foundation & Prototype build (Gift Of The Givers)
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
